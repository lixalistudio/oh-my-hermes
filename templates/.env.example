# ── App ──────────────────────────────────────────────────────────────────────
# Public URL of the app (used in redirects, emails, auth callbacks, Inngest)
APP_URL=http://localhost:3000
APP_VERSION=1.0.0
NODE_ENV=development
DEPLOYMENT_TARGET=cloudflare

# ── Cloudflare (default Lixali target) ───────────────────────────────────────
# From: dash.cloudflare.com → Manage Account → Account API Tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_ZONE_ID=your-zone-id-for-custom-domain

# D1 database (used by Elysia/Hono backend templates)
D1_DATABASE_ID=your-d1-database-id
D1_DATABASE_NAME=your-d1-database-name

# R2 object storage (used by backend templates)
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://pub-[hash].r2.dev

# ── Supabase ─────────────────────────────────────────────────────────────────
# From: supabase.com → Project Settings → API
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
# WARNING: Service key has full database access. Never expose to client.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:***@db.[ref].supabase.co:5432/postgres

# ── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000
# Used when the project exposes API keys (B2B, integrations, CLI clients)
BETTER_AUTH_API_KEY_ENABLED=true

# ── Inngest ──────────────────────────────────────────────────────────────────
# From: inngest.com → Environment → Event Keys / Signing Keys
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
INNGEST_API_URL=http://127.0.0.1:8288

# ── GitHub (used by CTO loop skills: issues, PRs, kanban) ────────────────────
# From: github.com → Settings → Developer settings → Personal access tokens → Fine-grained
# Required permissions: Contents (R/W), Issues (R/W), Pull requests (R/W), Metadata (R)
# On VPS (no browser): echo "TOKEN" | gh auth login --with-token
GITHUB_TOKEN=your-github-fine-grained-token
GITHUB_USERNAME=your-github-username
GITHUB_REPO=your-username/your-repo

# ── Cloudflare Pages / Workers deployment (Wrangler) ───────────────────────────
# From: dash.cloudflare.com → Workers & Pages → Manage Account API Tokens
# Prefer Cloudflare API token with Cloudflare Workers:Edit and Pages:Edit scopes
WRANGLER_API_TOKEN=your-cloudflare-api-token

# ── Alternative AWS target (optional) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=your-aws-region
AWS_DEPLOYMENT_TARGET=elastic-beanstalk
AWS_EB_APPLICATION_NAME=your-eb-application
AWS_EB_ENVIRONMENT_NAME=your-eb-environment

# ── Alternative VPS target via Shipnode (optional) ───────────────────────────
# See: https://github.com/devalade/shipnode
SHIPNODE_HOST=your-vps-ip-or-hostname
SHIPNODE_USER=root
SHIPNODE_SSH_KEY_PATH=~/.ssh/id_rsa
SHIPNODE_PROJECT_NAME=your-project-name
SHIPNODE_REPO=https://github.com/lixalistudio/your-project

# ── Notifications ─────────────────────────────────────────────────────────────
# Slack: api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=your-slack-webhook-url
# Telegram: create bot via @BotFather, get chat ID by messaging @userinfobot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ── Monitoring ────────────────────────────────────────────────────────────────
# From: sentry.io → Project → Settings → Client Keys
SENTRY_DSN=your-sentry-dsn
# From: sentry.io → Settings → Auth Tokens (for source map uploads)
SENTRY_AUTH_TOKEN=your-sentry-auth-token
# From: axiom.co → Settings → API Tokens
AXIOM_TOKEN=your-axiom-token
AXIOM_DATASET=your-axiom-dataset
# From: betterstack.com → Heartbeat / Uptime monitor URL
BETTER_STACK_URL=https://uptime.betterstack.com/api/v1/heartbeat/...

# ── Optional AI and publishing integrations ─────────────────────────────────
# Configure globally with scripts/setup-integrations.sh; never commit real keys.
OPENAI_API_KEY=your-openai-api-key
BUFFER_API_KEY=your-buffer-api-key
ARK_API_KEY=your-volcengine-ark-api-key
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-260128
